{
  "name": "tripreel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write dist scripts tests server.mjs eslint.config.js playwright.config.mjs package.json '*.md' docs .github",
    "format:check": "prettier --check dist scripts tests server.mjs eslint.config.js playwright.config.mjs package.json '*.md' docs .github",
    "check": "eslint . && pnpm run format:check",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@railroute-ts/china": "2026.9.1",
    "maplibre-gl": "6.10.0",
    "railroute-ts": "0.2.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "eslint": "10.11.0",
    "fake-indexeddb": "6.2.5",
    "globals": "17.12.0",
    "prettier": "3.9.9"
  },
  "description": "途映 · 把火车和飞机行程串成可回放、可导出视频的个人旅行地图",
  "keywords": [
    "travel",
    "maplibre",
    "railway",
    "flight",
    "journey"
  ]
}
